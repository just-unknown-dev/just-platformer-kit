{
  "author": {
    "name": "Just Unknown",
    "url": "https://justunknown.com"
  },
  "category": "kits",
  "description": "Player control, platforms (fixed and moving), patrolling enemies, hazards, collectibles, goals, level bounds and parallax backgrounds, and the Level Designer module that places them.",
  "editor": {
    "editorOnlyLibraries": [
      "editor.dart",
      "src/editor/"
    ],
    "modules": [
      {
        "class": "PlatformerModule",
        "library": "package:just_platformer_kit/editor.dart",
        "order": 10
      }
    ]
  },
  "id": "just_platformer_kit",
  "kind": "kit",
  "name": "Platformer Kit",
  "previews": [
    "store/card.png"
  ],
  "requires": {
    "just_game_engine": "^2.0.0-dev.2",
    "just_game_engine_editor": "^0.1.0-dev.1"
  },
  "runtime": {
    "componentTypes": [
      "CollectibleComponent",
      "GoalComponent",
      "HazardComponent",
      "LevelBoundsComponent",
      "MovingPlatformComponent",
      "ParallaxRectComponent",
      "PatrolEnemyComponent",
      "PlatformComponent",
      "PlayerControlComponent"
    ],
    "extensions": [
      {
        "const": "PlatformerKit.extension",
        "library": "package:just_platformer_kit/just_platformer_kit.dart",
        "order": 10
      }
    ],
    "setup": {
      "file": "lib/game/boot/game_boot.dart",
      "snippet": "PlatformerKit.registerSystems(\n  world,\n  physics: engine.physics,\n  camera: camera,\n  moveAction: GameActions.move,\n  jumpAction: GameActions.jump,\n);"
    }
  },
  "schema": 1,
  "stage": "beta",
  "summary": "Platformer gameplay and the Level Designer tools to build it.",
  "tags": [
    "platformer",
    "2d",
    "level design"
  ],
  "version": "0.1.0"
}
